{
  "name": "sulba",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @sulba/web dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "test:python": "uv run --directory packages/lab/python pytest",
    "check:content": "pnpm --filter @sulba/content check",
    "check:references": "pnpm --filter @sulba/content references",
    "check:machine": "pnpm --filter @sulba/content machine",
    "test:db": "pnpm --filter @sulba/data test:db",
    "test:e2e": "pnpm --filter @sulba/web test:e2e",
    "brand": "pnpm --filter @sulba/web brand",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:python": "uv run --directory packages/lab/python ruff check . ../../../courses ../../../tools && uv run --directory packages/lab/python ruff format --check . ../../../courses ../../../tools"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2"
  }
}
