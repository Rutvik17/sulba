 "long": {
  "messages": [
   {
    "role": "system",
    "content": "You answer customers' questions for a bicycle repair shop, in a sentence or two."
   },
   {
    "role": "user",
    "content": "Hi, my rear brake squeals when I stop."
   },
   {
    "role": "assistant",
    "content": "That's usually dirty or glazed pads. Cleaning them often fixes it."
   },
   {
    "role": "user",
    "content": "I cleaned them and it still squeals."
   },
   {
    "role": "assistant",
    "content": "Then the pads may need replacing. We can fit new ones while you wait."
   },
   {
    "role": "user",
    "content": "How much would that be?"
   },
   {
    "role": "assistant",
    "content": "New pads for one brake are £18, fitted."
   },
   {
    "role": "user",
    "content": "And for both brakes?"
   },
   {
    "role": "assistant",
    "content": "Both would be £32, fitted."
   },
   {
    "role": "user",
    "content": "Do you have time this afternoon?"
   },
   {
    "role": "assistant",
    "content": "We have a slot at 3pm today."
   },
   {
    "role": "user",
    "content": "Can my son come instead of me?"
   },
   {
    "role": "assistant",
    "content": "Of course. He only needs to bring the bike."
   },
   {
    "role": "user",
    "content": "Do you take cards?"
   },
   {
    "role": "assistant",
    "content": "Yes, cards and contactless."
   },
   {
    "role": "user",
    "content": "Is there parking nearby?"
   },
   {
    "role": "assistant",
    "content": "There's a car park two minutes away on foot."
   },
   {
    "role": "user",
    "content": "Great. Can you also check the gears while it's in?"
   }
  ],
