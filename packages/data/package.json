{
  "name": "@sulba/data",
  "private": true,
  "type": "module",
  "exports": {
    "./account": "./src/account.ts",
    "./agents": "./src/agents.ts",
    "./client": "./src/client.ts",
    "./evidence": "./src/evidence.ts",
    "./outbox": "./src/outbox.ts",
    "./project": "./src/project.ts",
    "./requests": "./src/requests.ts",
    "./reviewers": "./src/reviewers.ts",
    "./reviews": "./src/reviews.ts",
    "./session": "./src/session.ts",
    "./specs": "./src/specs.ts",
    "./tasks": "./src/tasks.ts",
    "./study": "./src/study.ts",
    "./sync": "./src/sync.ts",
    "./work": "./src/work.ts",
    "./workspaces": "./src/workspaces.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run",
    "test:db": "supabase db start && supabase db reset && supabase test db",
    "types": "supabase gen types typescript --local --schema public > src/database.ts && biome format --write src/database.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "supabase": "2.122.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
