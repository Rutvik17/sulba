---
// Every component in each of its states, for building and reviewing the interface. The route
// exists only in development and in builds that ask for it (astro.config.ts).
import { renderProse } from '@sulba/content/prose';
import { buttonClass } from '@sulba/ui/button';
import { segmentedClass } from '@sulba/ui/segmented';
import SectionHeading from '../components/SectionHeading.astro';
import Page from '../layouts/Page.astro';
import ChartDemo from './ChartDemo';
import DockerfileEditorDemo from './DockerfileEditorDemo';
import EditorDemo from './EditorDemo';
import formulas from './formulas.md?raw';
import MenuDemo from './MenuDemo';
import PanelDemo from './PanelDemo';
import PressCount from './PressCount';
import ReadOnlyEditorDemo from './ReadOnlyEditorDemo';
import SegmentedDemo from './SegmentedDemo';
import SliderDemo from './SliderDemo';
import TabsDemo from './TabsDemo';
import TypeScriptEditorDemo from './TypeScriptEditorDemo';

// Formulas as a lab's prose shows them, made by the same renderer when the site is built.
const prose = renderProse(formulas, {}).html;

const buttons = [
  { variant: 'primary', name: 'Primary', label: 'Run tests' },
  { variant: 'outline', name: 'Outline', label: 'Show a hint' },
  { variant: 'ghost', name: 'Ghost', label: 'Reset' },
] as const;
---

<Page title="Components · Sulba" editor>
  <header class="intro">
    <h1>Components</h1>
    <p>Every component in each of its states. The theme control in the top bar switches themes.</p>
  </header>

  <section aria-labelledby="button">
    <SectionHeading id="button" text="Button" />
    {buttons.map(({ variant, name, label }) => (
      <div class="row">
        <h3>{name}</h3>
        <ul class="states">
          <li>
            <button class={buttonClass(variant)} type="button">
              {label}
            </button>
            <span>Regular</span>
          </li>
          <li>
            <button class={buttonClass(variant, 'small')} type="button">
              {label}
            </button>
            <span>Small</span>
          </li>
          <li>
            <button class={buttonClass(variant)} type="button" disabled>
              {label}
            </button>
            <span>Disabled</span>
          </li>
        </ul>
      </div>
    ))}
    <div class="row">
      <h3>In a React island</h3>
      <div class="island">
        <PressCount client:load />
      </div>
    </div>
  </section>

  <section aria-labelledby="segmented">
    <SectionHeading id="segmented" text="Segmented choice" />
    <div class="row">
      <h3>In a React island</h3>
      <div class="island">
        <SegmentedDemo client:load />
      </div>
    </div>
    <div class="row">
      <h3>Native radio buttons</h3>
      <fieldset class="native">
        <legend>Theme</legend>
        <div class={segmentedClass.group}>
          {['System', 'Light', 'Dark'].map((label, i) => (
            <label class={segmentedClass.segment}>
              <input type="radio" name="gallery-theme" value={label} checked={i === 0}>
              {label}
            </label>
          ))}
        </div>
      </fieldset>
    </div>
  </section>

  <section aria-labelledby="tabs">
    <SectionHeading id="tabs" text="Tabs" />
    <div class="row">
      <h3>In a React island</h3>
      <div class="wide">
        <TabsDemo client:load />
      </div>
    </div>
  </section>

  <section aria-labelledby="slider">
    <SectionHeading id="slider" text="Slider" />
    <div class="row">
      <h3>In a React island</h3>
      <div class="sliders">
        <SliderDemo client:load />
      </div>
    </div>
  </section>

  <section aria-labelledby="panel">
    <SectionHeading id="panel" text="Side panel" />
    <div class="row">
      <h3>In a React island</h3>
      <div class="island">
        <PanelDemo client:load />
      </div>
    </div>
  </section>

  <section aria-labelledby="menu">
    <SectionHeading id="menu" text="Menu" />
    <div class="row">
      <h3>In a React island</h3>
      <div class="island">
        <MenuDemo client:load />
      </div>
    </div>
  </section>

  <section aria-labelledby="formulas">
    <SectionHeading id="formulas" text="Formulas" />
    <div class="row">
      <h3>In prose</h3>
      <div class="prose" set:html={prose} />
    </div>
  </section>

  <section aria-labelledby="editor">
    <SectionHeading id="editor" text="Code editor" />
    <div class="row">
      <h3>In a React island</h3>
      <div class="code">
        <EditorDemo client:load />
      </div>
    </div>
    <div class="row">
      <h3>Read only</h3>
      <div class="code">
        <ReadOnlyEditorDemo client:load />
      </div>
    </div>
    <div class="row">
      <h3>Read only, in TypeScript</h3>
      <div class="code">
        <TypeScriptEditorDemo client:load />
      </div>
    </div>
    <div class="row">
      <h3>Read only, a Dockerfile</h3>
      <div class="code">
        <DockerfileEditorDemo client:load />
      </div>
    </div>
  </section>

  <section aria-labelledby="chart">
    <SectionHeading id="chart" text="Chart" />
    <div class="row">
      <h3>In a React island</h3>
      <div class="charts">
        <ChartDemo client:load />
      </div>
    </div>
  </section>
</Page>

<style>
.intro {
  display: grid;
  gap: var(--space-4);
  padding-block: var(--space-16) var(--space-12);
}

h1 {
  font: 400 clamp(2.5rem, 5vw, 4rem) / 1 var(--font-display);
  letter-spacing: -0.01em;
}

.intro p {
  max-width: 60ch;
  color: var(--dim);
}

section {
  margin-bottom: var(--space-16);
}

.row {
  display: grid;
  grid-template-columns: 11rem minmax(0, 1fr);
  gap: var(--space-4) var(--space-8);
  padding-block: var(--space-6);
  border-top: 1px solid var(--line);
}

h3 {
  padding-top: var(--space-3);
  color: var(--dim);
  font: 500 var(--text-xs) / 1.4 var(--font-mono);
  letter-spacing: var(--tracking-label);
  text-transform: uppercase;
}

.states {
  display: flex;
  flex-wrap: wrap;
  align-items: start;
  gap: var(--space-6) var(--space-8);
  margin: 0;
  padding: 0;
  list-style: none;
}

/* A row as tall as a regular button, so every caption sits on one line. */
.states li {
  display: grid;
  grid-template-rows: 40px auto;
  align-items: center;
  justify-items: start;
  gap: var(--space-2);
}

.states span {
  color: var(--dim);
  font-size: var(--text-xs);
}

.island {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-4);
  color: var(--dim);
  font-size: var(--text-sm);
}

.wide {
  min-width: 0;
  max-width: 640px;
}

.sliders {
  display: grid;
  gap: var(--space-6);
  max-width: 360px;
}

.charts {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  gap: var(--space-8);
  min-width: 0;
  max-width: 960px;
}

.charts :global(figure) {
  display: grid;
  gap: var(--space-4);
  align-content: start;
  min-width: 0;
  margin: 0;
}

.code {
  min-width: 0;
  max-width: 720px;
}

.prose {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-4);
  min-width: 0;
  max-width: 640px;
  line-height: var(--leading);
}

.prose :global(:is(article, p)) {
  margin: 0;
}

.prose :global(article) {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-4);
}

.prose :global([data-scroll]) {
  display: flex;
  overflow-x: auto;
  /* A formula's lines of text reach a little above and below it, which mustn't scroll. */
  overflow-y: hidden;
}

.prose :global([data-scroll] > math) {
  margin-inline: auto;
}

.code :global(.editor-frame) {
  width: 100%;
  height: 320px;
}

.code :global(.editor-frame.fit) {
  height: auto;
}

.native {
  margin: 0;
  padding: 0;
  border: 0;
}

.native legend {
  margin-bottom: var(--space-3);
  padding: 0;
  color: var(--dim);
  font-size: var(--text-xs);
}

@media (max-width: 640px) {
  .row {
    grid-template-columns: minmax(0, 1fr);
  }

  h3 {
    padding-top: 0;
  }
}
</style>
