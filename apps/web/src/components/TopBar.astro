---
import { academy, academyPage } from '../lib/academy';
import Mark from './Mark.astro';
import ThemeControl from './ThemeControl.astro';

interface Props {
  /** Whether the page has a code editor, whose themes the theme panel then offers too. */
  editor?: boolean | undefined;
}

const { editor } = Astro.props;

// Sign-in brings the learner back to the page they started from.
const here = Astro.url.pathname;
const signIn = ['/sign-in/', '/account/'].includes(here)
  ? '/sign-in/'
  : `/sign-in/?next=${encodeURIComponent(here)}`;
const review = academyPage('review');
---

<header class="bar">
  <div class="inner">
    <a class="brand" href={academy}>
      <Mark />
      <span>Sulba</span>
    </a>
    <div class="end">
      <a class="link" href={review} aria-current={here === review ? 'page' : undefined}>Review</a>
      <a class="link signed-out" href={signIn}>Sign in</a>
      <a class="link signed-in" href="/account/">Account</a>
      <ThemeControl editor={editor} />
    </div>
  </div>
</header>

<style>
.bar {
  position: sticky;
  top: 0;
  z-index: 20;
  background: color-mix(in srgb, var(--bg) 88%, transparent);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line);
}

.inner {
  display: flex;
  align-items: center;
  gap: var(--space-5);
  height: 60px;
  max-width: var(--sheet);
  margin-inline: auto;
  padding-inline: var(--gutter);
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 600;
  letter-spacing: -0.01em;
  text-decoration: none;
}

.end {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-left: auto;
}

.link {
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  font-weight: 500;
  text-decoration: none;
}

.link:hover,
.link[aria-current="page"] {
  background: var(--line);
}

/* Page.astro marks the page before its first paint when this browser holds a session. */
:global(:root[data-signed-in]) .signed-out,
:global(:root:not([data-signed-in])) .signed-in {
  display: none;
}
</style>
