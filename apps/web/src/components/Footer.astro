---
const links = [
  { href: '/about/', text: 'About' },
  { href: 'https://github.com/Rutvik17/sulba', text: 'Source code' },
] as const;

// The same page with or without its trailing slash.
const here = Astro.url.pathname.replace(/\/?$/, '/');
---

<footer class="foot">
  <div class="inner">
    <span>© 2026 Sulba</span>
    <nav aria-label="Footer">
      {links.map(({ href, text }) => (
        <a href={href} aria-current={href === here ? 'page' : undefined}>
          {text}
        </a>
      ))}
    </nav>
  </div>
</footer>

<style>
.foot {
  margin-top: var(--space-16);
  border-top: 1px solid var(--line);
}

.inner {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: var(--space-3) var(--space-4);
  max-width: var(--sheet);
  margin-inline: auto;
  padding: var(--space-6) var(--gutter) var(--space-10);
  color: var(--dim);
  font-size: var(--text-sm);
}

nav {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2) var(--space-5);
}

a:hover,
a[aria-current="page"] {
  color: var(--fg);
}
</style>
