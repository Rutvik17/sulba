---
// Line drawings for what Sulba teaches, in fixed geometry on a 300 by 200 grid.
interface Props {
  kind: 'build' | 'with-ai' | 'review' | 'design';
}

const { kind } = Astro.props;
---

<svg class="art" viewBox="0 0 300 200" aria-hidden="true">
  {kind === 'build' && (
    <>
      <path class="fill" d="M60 118 L150 73 L240 118 L240 128 L150 173 L60 128 Z" />
      <path d="M60 118 L150 73 L240 118 L150 163 Z M60 118 L60 128 L150 173 L240 128 L240 118 M150 163 L150 173" />
      <path class="fill" d="M60 94 L150 49 L240 94 L240 104 L150 149 L60 104 Z" />
      <path d="M60 94 L150 49 L240 94 L150 139 Z M60 94 L60 104 L150 149 L240 104 L240 94 M150 139 L150 149" />
      <path class="fill" d="M60 70 L150 25 L240 70 L240 80 L150 125 L60 80 Z" />
      <path d="M60 70 L150 25 L240 70 L150 115 Z M60 70 L60 80 L150 125 L240 80 L240 70 M150 115 L150 125" />
      <path class="accent" d="M105 70 L150 47.5 L195 70 L150 92.5 Z" />
      <path class="soft" d="M127.5 58.75 L172.5 81.25 M127.5 81.25 L172.5 58.75" />
      <circle class="dot" cx="150" cy="25" r="2.5" />
      <circle class="dot" cx="60" cy="70" r="2.5" />
      <circle class="dot" cx="240" cy="70" r="2.5" />
      <circle class="dot" cx="150" cy="173" r="2.5" />
    </>
  )}
  {kind === 'with-ai' && (
    <>
      <rect x="36" y="58" width="96" height="84" />
      <path d="M48 76 L56 82 L48 88 M64 82 L112 82 M48 102 L104 102" />
      <path class="soft" d="M48 118 L92 118" />
      <rect x="168" y="40" width="100" height="120" />
      <path d="M182 60 L238 60 M182 76 L254 76 M196 92 L250 92 M196 108 L232 108 M182 124 L224 124" />
      <path class="accent" d="M196 140 L246 140" />
      <path d="M132 74 L150 74 L150 64 L168 64" />
      <path class="soft" d="M168 136 L150 136 L150 126 L132 126" />
      <circle class="dot" cx="150" cy="74" r="2.5" />
      <circle class="dot" cx="150" cy="126" r="2.5" />
      <circle class="dot" cx="168" cy="64" r="2.5" />
      <circle class="dot" cx="132" cy="126" r="2.5" />
    </>
  )}
  {kind === 'review' && (
    <>
      <rect x="40" y="32" width="150" height="136" />
      <path class="soft" d="M40 52 L190 52" />
      <path d="M56 70 L120 70 M56 84 L150 84 M70 98 L140 98 M70 112 L172 112 M70 140 L128 140 M56 154 L104 154" />
      <path class="soft" d="M70 126 L160 126" />
      <path class="accent" d="M70 117 L172 117" />
      <circle class="dot" cx="58" cy="112" r="2.5" />
      <path class="soft" d="M190 112 L208 112 L208 90 L218 90" />
      <circle class="dot" cx="208" cy="112" r="2.5" />
      <rect x="218" y="72" width="52" height="40" />
      <path d="M228 86 L258 86 M228 98 L248 98" />
      <circle class="dot" cx="218" cy="72" r="2.5" />
    </>
  )}
  {kind === 'design' && (
    <>
      <path
        class="soft"
        d="M90 100 L110 100 L110 55 L125 55 M110 100 L110 145 L125 145 M175 55 L190 55 L190 100 L210 100 M175 145 L190 145 L190 100"
      />
      <rect x="40" y="85" width="50" height="30" />
      <rect x="125" y="40" width="50" height="30" />
      <rect x="125" y="130" width="50" height="30" />
      <rect class="accent" x="210" y="85" width="50" height="30" />
      <rect class="accent" x="214" y="89" width="42" height="22" />
      <circle class="dot" cx="110" cy="100" r="2.5" />
      <circle class="dot" cx="190" cy="100" r="2.5" />
    </>
  )}
</svg>

<style>
.art {
  width: 100%;
  height: 100%;
  fill: none;
  stroke: var(--fg);
  stroke-width: 1;
}

.art * {
  vector-effect: non-scaling-stroke;
}

.soft {
  stroke: var(--faint);
}

.accent {
  stroke: var(--accent);
}

.fill {
  fill: var(--raise);
  stroke: none;
}

.dot {
  fill: var(--fg);
  stroke: none;
}
</style>
