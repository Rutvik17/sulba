---
import { cordPath, pegs } from '@sulba/ui/mark';
import { assistantTests, checkLines, edits, select } from '../lib/session-clip';
import Frame from './Frame.astro';
import TestStatus from './TestStatus.astro';
---

<figure class="clip" data-session>
  <Frame>
    <div
      class="window"
      role="img"
      aria-label="A Catch stage in AI Engineering. An assistant's order-lookup tool passes its own two tests but only one of two production checks, because it pastes the customer's name into its SQL query. The learner makes the query take the name as a parameter, and both checks pass."
    >
      <div class="chrome">
        <span class="crumbs">AI Engineering <i>/</i> Intermediate <i>/</i> Agents</span>
        <svg class="mark" viewBox="0 0 100 100" aria-hidden="true">
          <path d={cordPath} />
          {pegs.map(([x, y]) => <circle cx={x} cy={y} r="8" />)}
        </svg>
      </div>

      <div class="stage panes">
        <div class="pane brief">
          <div class="head"><span class="tag">Brief</span><span class="tag">Catch</span></div>
          <div class="body">
            <h3>Look up a customer's orders</h3>
            <p>
              An assistant wrote the lookup tool your support agent calls, and its own tests pass.
              Review it before it goes live.
            </p>
            <dl>
              <dt class="tag">Function</dt>
              <dd>find_orders(db, name)</dd>
            </dl>
          </div>
        </div>

        <div class="pane code">
          <div class="head">
            <span class="file">tools.py</span><span class="draft">Assistant draft</span>
          </div>
          <pre class="editor"><code>
<span class="ln" data-n="1"><span class="src"><span class="kw">import</span> sqlite3</span></span>
<span class="ln" data-n="2"><span class="src"></span></span>
<span class="ln" data-n="3"><span class="src"></span></span>
<span class="ln" data-n="4"><span class="src"><span class="kw">def</span> <span class="fn">find_orders</span>(db: sqlite3.Connection, name: str) -&gt; list[tuple]:</span></span>
<span class="ln" data-n="5"><span class="src in">    <span class="doc">"""Look up a customer's orders for the support agent."""</span></span></span>
<span class="ln" data-n="6"><span class="src in">    query = <span class="rm" data-rm="a"><span class="picked"></span><span class="kept">{edits.a.remove}</span></span><span class="ins" data-ins="a"></span><span class="caret" data-caret="a"></span>"{select}<span class="rm" data-rm="b"><span class="picked"></span><span class="kept">{edits.b.remove}</span></span><span class="ins" data-ins="b"></span><span class="caret" data-caret="b"></span>"</span></span>
<span class="ln" data-n="7"><span class="src in">    <span class="kw">return</span> db.execute(query<span class="ins" data-ins="c"></span><span class="caret" data-caret="c"></span>).fetchall()</span></span>
</code></pre>
        </div>

        <div class="pane tests">
          <div class="head">
            <span class="tag">Tests</span>
            <span class="run" data-run>
              <svg viewBox="0 0 8 10" aria-hidden="true"><path d="M0 0 L8 5 L0 10 Z" /></svg>
              Run tests
            </span>
          </div>
          <p class="group">The assistant's tests</p>
          <ol class="results">
            {assistantTests.map((name) => (
              <li data-state="idle">
                <TestStatus />
                <span>{name}</span>
              </li>
            ))}
          </ol>
          <p class="group">Production checks</p>
          <p class="checks" data-state="idle">
            <TestStatus />
            <span class="line">{checkLines.idle}</span>
          </p>
          <div class="notes">
            <p class="note hidden-note">
              Which check fails stays hidden until you finish the review.
            </p>
            <p class="note done-note">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <circle cx="7" cy="7" r="7" />
                <path d="M4.2 7.3l1.9 1.9 3.8-4.3" />
              </svg>
              Done <span>· Nothing missed</span>
            </p>
          </div>
        </div>
      </div>

      <span class="pointer" data-shape="arrow" aria-hidden="true">
        <svg class="arrow" viewBox="0 0 18 22" aria-hidden="true">
          <path d="M2 2 L2 17.5 L6.2 13.6 L9.1 20.2 L11.9 19 L9 12.5 L14.6 12.5 Z" />
        </svg>
        <svg class="beam" viewBox="0 0 12 22" aria-hidden="true">
          <path
            class="halo"
            d="M3 2.5C4.6 2.5 6 3.3 6 5C6 3.3 7.4 2.5 9 2.5M6 5V17M3 19.5C4.6 19.5 6 18.7 6 17C6 18.7 7.4 19.5 9 19.5"
          />
          <path
            d="M3 2.5C4.6 2.5 6 3.3 6 5C6 3.3 7.4 2.5 9 2.5M6 5V17M3 19.5C4.6 19.5 6 18.7 6 17C6 18.7 7.4 19.5 9 19.5"
          />
        </svg>
      </span>
    </div>
  </Frame>
  <figcaption>
    <span class="number">Fig. 1</span>
    <span class="text"
      >A Catch stage in AI Engineering. The assistant's tests pass, a production check doesn't, and
      you fix the code.</span
    >
    <button class="pause" type="button" data-mode="playing">
      <svg class="icon-pause" viewBox="0 0 9 9" aria-hidden="true">
        <rect x="1" y="0.5" width="2.4" height="8" />
        <rect x="5.6" y="0.5" width="2.4" height="8" />
      </svg>
      <svg class="icon-play" viewBox="0 0 9 9" aria-hidden="true">
        <path d="M1.5 0.5 L8.5 4.5 L1.5 8.5 Z" />
      </svg>
      <svg class="icon-replay" viewBox="0 0 9 9" aria-hidden="true">
        <path d="M7.6 5.2 A3.3 3.3 0 1 1 6.4 2.1" />
        <path class="head" d="M5.2 0.6 L8.2 1.6 L6.2 4 Z" />
      </svg>
      <span class="label">Pause</span>
    </button>
  </figcaption>
</figure>

<script>
import {
  type Checks,
  checkLines,
  type EditId,
  END,
  edits,
  frameAt,
  type Place,
  type TestState,
} from '../lib/session-clip';

function must<T>(value: T | null | undefined, what: string): T {
  if (value === null || value === undefined) throw new Error(`Fig. 1 has no ${what}`);
  return value;
}

// The checks line wears the same marks as a test: a cross while one fails, a tick when both pass.
const checkState: Record<Checks, TestState> = {
  idle: 'idle',
  running: 'running',
  some: 'fail',
  all: 'pass',
};

function play(figure: HTMLElement) {
  const find = <T extends Element>(selector: string) =>
    must(figure.querySelector<T>(selector), selector);
  const win = find<HTMLElement>('.window');
  const stage = find<HTMLElement>('.stage');
  const pointer = find<HTMLElement>('.pointer');
  const run = find<HTMLElement>('[data-run]');
  const editor = find<HTMLElement>('.editor');
  const tests = find<HTMLElement>('.tests');
  const ids: readonly EditId[] = ['a', 'b', 'c'];
  const parts = (id: EditId) => ({
    picked: figure.querySelector<HTMLElement>(`[data-rm="${id}"] .picked`),
    kept: figure.querySelector<HTMLElement>(`[data-rm="${id}"] .kept`),
    removal: figure.querySelector<HTMLElement>(`[data-rm="${id}"]`),
    insertion: find<HTMLElement>(`[data-ins="${id}"]`),
    caret: find<HTMLElement>(`[data-caret="${id}"]`),
  });
  const edit = { a: parts('a'), b: parts('b'), c: parts('c') };
  const rows = [...figure.querySelectorAll<HTMLElement>('.results li')];
  const checks = find<HTMLElement>('.checks');
  const checksLine = find<HTMLElement>('.checks .line');
  const hiddenNote = find<HTMLElement>('.hidden-note');
  const doneNote = find<HTMLElement>('.done-note');
  const toggle = find<HTMLButtonElement>('.pause');
  const label = find<HTMLElement>('.pause .label');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  // Where the pointer goes, measured from the page so it follows the layout at any width. The
  // point is its hot spot: the arrow's tip, or the middle of the I-beam.
  function point(place: Place) {
    const box = win.getBoundingClientRect();
    if (place === 'run') {
      const r = run.getBoundingClientRect();
      return { x: r.left - box.left + r.width * 0.55, y: r.top - box.top + r.height * 0.62 };
    }
    if (place === 'rest') {
      const r = tests.getBoundingClientRect();
      return { x: r.right - box.left - 40, y: r.bottom - box.top - 18 };
    }
    // In the code. a: just after the f. b: the start of the quoted name, b-sel its end.
    // An -end place is where that edit's typing finished; c is where its insertion goes.
    const target =
      place === 'a' || place === 'b' || place === 'b-sel'
        ? must(edit[place === 'a' ? 'a' : 'b'].removal, place)
        : edit[place === 'a-end' ? 'a' : place === 'b-end' ? 'b' : 'c'].insertion;
    const r = target.getBoundingClientRect();
    const x = place === 'b' || place === 'c' ? r.left : r.right;
    return { x: x - box.left + 1, y: r.top - box.top + r.height * 0.55 };
  }

  // Over the code the pointer is an I-beam, as in an editor.
  function overCode(x: number, y: number) {
    const box = win.getBoundingClientRect();
    const r = editor.getBoundingClientRect();
    return (
      x >= r.left - box.left &&
      x <= r.right - box.left &&
      y >= r.top - box.top &&
      y <= r.bottom - box.top
    );
  }

  function draw(clock: number) {
    const frame = frameAt(clock);
    for (const id of ids) {
      const state = frame.edits[id];
      const { remove, insert } = edits[id];
      const { picked, kept, insertion, caret } = edit[id];
      if (picked && kept) {
        picked.textContent = state.removed ? '' : remove.slice(0, state.selected);
        kept.textContent = state.removed ? '' : remove.slice(state.selected);
      }
      insertion.textContent = insert.slice(0, state.typed);
      insertion.classList.toggle('fresh', state.fresh);
      caret.classList.toggle('on', frame.caret === id && (frame.typing || frame.blink));
    }
    frame.tests.forEach((state, i) => {
      const row = rows[i];
      if (row && row.dataset.state !== state) row.dataset.state = state;
    });
    const state = checkState[frame.checks];
    if (checks.dataset.state !== state) {
      checks.dataset.state = state;
      checksLine.textContent = checkLines[frame.checks];
    }
    hiddenNote.classList.toggle('on', frame.hiddenNote);
    doneNote.classList.toggle('on', frame.done);
    run.classList.toggle('down', frame.down);

    const from = point(frame.pointer.from);
    const to = point(frame.pointer.to);
    const { k } = frame.pointer;
    const x = from.x + (to.x - from.x) * k;
    const y = from.y + (to.y - from.y) * k;
    pointer.dataset.shape = overCode(x, y) ? 'text' : 'arrow';
    pointer.style.translate = `${x}px ${y}px`;
    pointer.style.scale = frame.press ? '0.86' : '1';
    pointer.style.opacity = frame.away ? '0' : '1';
  }

  let clock = 0;

  // The tallest moment sets the figure's height, so the page below never moves while it plays.
  function lockHeight() {
    stage.style.minHeight = '';
    let tallest = 0;
    for (const moment of [0, 2900, 4500, END]) {
      draw(moment);
      tallest = Math.max(tallest, stage.getBoundingClientRect().height);
    }
    stage.style.minHeight = `${Math.ceil(tallest)}px`;
    draw(reduce.matches ? END : clock);
  }

  // It plays once while it's on screen, rests on its last frame, and replays on request.
  type Mode = 'playing' | 'paused' | 'ended';
  let mode: Mode = 'playing';
  let previous: number | null = null;
  let frame = 0;
  let onScreen = false;

  function show(next: Mode) {
    mode = next;
    toggle.dataset.mode = next;
    label.textContent = next === 'playing' ? 'Pause' : next === 'paused' ? 'Play' : 'Replay';
  }

  function tick(now: number) {
    if (previous !== null) clock = Math.min(END, clock + Math.min(now - previous, 64));
    previous = now;
    draw(clock);
    if (clock >= END) {
      frame = 0;
      show('ended');
      return;
    }
    frame = requestAnimationFrame(tick);
  }

  function update() {
    const playing = mode === 'playing' && onScreen && !document.hidden && !reduce.matches;
    if (playing && !frame) {
      previous = null;
      frame = requestAnimationFrame(tick);
    } else if (!playing && frame) {
      cancelAnimationFrame(frame);
      frame = 0;
    }
    toggle.hidden = reduce.matches;
    if (reduce.matches) draw(END);
  }

  toggle.addEventListener('click', () => {
    if (mode === 'ended') {
      clock = 0;
      draw(clock);
    }
    show(mode === 'playing' ? 'paused' : 'playing');
    update();
  });
  document.addEventListener('visibilitychange', update);
  reduce.addEventListener('change', update);

  lockHeight();
  document.fonts.ready.then(lockHeight);
  let width = 0;
  new ResizeObserver(([entry]) => {
    if (!entry || Math.abs(entry.contentRect.width - width) < 1) return;
    width = entry.contentRect.width;
    lockHeight();
  }).observe(figure);
  new IntersectionObserver(
    ([entry]) => {
      onScreen = entry?.isIntersecting ?? false;
      update();
    },
    { threshold: 0.2 },
  ).observe(figure);
  update();
}

for (const figure of document.querySelectorAll<HTMLElement>('[data-session]')) play(figure);
</script>

<style>
.clip {
  margin-top: var(--space-12);
}

.window {
  position: relative;
  overflow: hidden;
  background: var(--surface);
  user-select: none;
}

.chrome {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 40px;
  padding-inline: var(--space-4);
  border-bottom: 1px solid var(--line);
}

.crumbs,
.tag,
.draft,
.group,
.number,
.pause {
  font: 500 var(--text-xs) / 1 var(--font-mono);
  letter-spacing: var(--tracking-label);
  text-transform: uppercase;
}

.crumbs {
  display: flex;
  gap: var(--space-2);
  color: var(--dim);
}

.crumbs i {
  font-style: normal;
}

.mark {
  width: 16px;
  height: 16px;
  color: var(--dim);
}

.mark path {
  fill: none;
  stroke: currentColor;
  stroke-width: 8;
  stroke-linejoin: round;
}

.mark circle {
  fill: currentColor;
}

.panes {
  display: grid;
  grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.9fr) minmax(0, 1.05fr);
}

.pane {
  min-width: 0;
}

.pane + .pane {
  border-left: 1px solid var(--line);
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  height: 48px;
  padding-inline: var(--space-5);
  border-bottom: 1px solid var(--line);
}

.tag {
  color: var(--dim);
}

.body {
  display: grid;
  gap: var(--space-3);
  padding: var(--space-5);
}

.brief h3 {
  font-size: var(--text-xl);
  font-weight: 600;
  letter-spacing: -0.015em;
  line-height: 1.2;
}

.brief p {
  color: var(--dim);
  font-size: var(--text-sm);
}

.brief dl {
  display: grid;
  gap: var(--space-1);
  margin-top: var(--space-3);
  padding-top: var(--space-4);
  border-top: 1px dashed var(--line-2);
}

.brief dd {
  font: 400 var(--text-sm) / 1.5 var(--font-mono);
}

.code {
  display: flex;
  flex-direction: column;
}

.file {
  font: 400 var(--text-sm) / 1 var(--font-mono);
}

.draft {
  display: inline-flex;
  align-items: center;
  height: 22px;
  padding-inline: var(--space-2);
  border: 1px dashed var(--line-strong);
  border-radius: var(--radius-full);
  color: var(--dim);
  font-size: 10px;
}

.editor {
  flex: 1;
  margin: 0;
  padding: var(--space-5) var(--space-5) var(--space-5) 0;
  font: 400 13px / 1.8 var(--font-mono);
}

.editor code {
  display: grid;
}

.ln {
  display: grid;
  grid-template-columns: 40px minmax(0, 1fr);
}

.ln::before {
  content: attr(data-n);
  padding-right: var(--space-4);
  color: var(--dim);
  text-align: right;
}

/* Long lines wrap with a hanging indent; code never scrolls sideways. */
.src {
  min-height: 1.8em;
  padding-left: 4ch;
  text-indent: -4ch;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.src.in {
  padding-left: 8ch;
  text-indent: -8ch;
}

.kw {
  color: var(--accent);
}

.fn {
  font-weight: 600;
}

.doc {
  color: var(--dim);
}

.ins {
  border-radius: 3px;
  transition: background-color 600ms var(--ease);
}

.ins.fresh {
  background: color-mix(in srgb, var(--accent) 22%, transparent);
}

.picked {
  border-radius: 3px;
  background: color-mix(in srgb, var(--accent) 34%, transparent);
}

.caret {
  display: inline-block;
  width: 0;
  height: 1.25em;
  margin-right: -1.5px;
  vertical-align: -0.25em;
  border-left: 1.5px solid var(--fg);
  visibility: hidden;
}

.caret.on {
  visibility: visible;
}

.run {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  height: 30px;
  padding-inline: var(--space-3);
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-full);
  background: var(--bg);
  font-size: var(--text-sm);
  font-weight: 500;
  white-space: nowrap;
  transition:
    background-color var(--duration-quick) var(--ease),
    scale var(--duration-quick) var(--ease);
}

.run svg {
  width: 8px;
  height: 10px;
  fill: currentColor;
}

.run.down {
  background: var(--raise);
  scale: 0.96;
}

.group {
  margin: var(--space-4) var(--space-5) 0;
  color: var(--dim);
}

.results {
  margin: 0;
  padding: var(--space-1) 0;
  list-style: none;
}

.results li,
.checks {
  display: grid;
  grid-template-columns: 16px minmax(0, 1fr);
  column-gap: var(--space-3);
  align-items: start;
  padding: var(--space-2) var(--space-5);
  font-size: var(--text-sm);
}

.checks {
  padding-bottom: var(--space-3);
}

.checks[data-state="fail"] .line {
  color: var(--bad);
}

.checks[data-state="pass"] .line {
  color: var(--ok);
}

/* One cell under the checks holds the note about hidden checks, then "Done", so the figure never
   changes height while it plays. */
.notes {
  display: grid;
  margin: var(--space-1) var(--space-5) var(--space-5);
}

.note {
  grid-area: 1 / 1;
  padding: var(--space-3) var(--space-4);
  border: 1px solid var(--line-2);
  border-radius: var(--radius);
  background: var(--bg);
  font-size: var(--text-sm);
  opacity: 0;
  translate: 0 6px;
  transition:
    opacity 360ms var(--ease),
    translate 360ms var(--ease);
}

.note.on {
  opacity: 1;
  translate: 0 0;
}

.hidden-note {
  color: var(--dim);
}

.done-note {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.done-note svg {
  width: 14px;
  height: 14px;
}

.done-note circle {
  fill: var(--ok);
}

.done-note path {
  fill: none;
  stroke: var(--bg);
  stroke-width: 1.6;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.done-note span {
  color: var(--dim);
}

.pointer {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 5;
  width: 0;
  height: 0;
  pointer-events: none;
}

.pointer svg {
  position: absolute;
  max-width: none;
  overflow: visible;
}

.arrow {
  top: -2px;
  left: -2px;
  width: 18px;
  height: 22px;
}

.arrow path {
  fill: var(--fg);
  stroke: var(--bg);
  stroke-width: 1.25;
  stroke-linejoin: round;
}

.beam {
  top: -11px;
  left: -6px;
  width: 12px;
  height: 22px;
}

.beam path {
  fill: none;
  stroke: var(--fg);
  stroke-width: 1.5;
  stroke-linecap: round;
}

.beam .halo {
  stroke: var(--bg);
  stroke-width: 4;
}

.pointer[data-shape="arrow"] .beam,
.pointer[data-shape="text"] .arrow {
  display: none;
}

figcaption {
  display: flex;
  align-items: baseline;
  gap: var(--space-4);
  padding-top: var(--space-3);
  color: var(--dim);
  font-size: var(--text-sm);
}

.number {
  color: var(--fg);
}

.text {
  flex: 1;
}

.pause {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  height: 28px;
  padding-inline: var(--space-3);
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-full);
  background: none;
  cursor: pointer;
}

.pause svg {
  width: 9px;
  height: 9px;
  fill: currentColor;
}

.pause .icon-replay {
  fill: none;
  stroke: currentColor;
  stroke-width: 1.3;
  stroke-linecap: round;
}

.pause .icon-replay .head {
  fill: currentColor;
  stroke: none;
}

.pause[hidden],
.pause:not([data-mode="playing"]) .icon-pause,
.pause:not([data-mode="paused"]) .icon-play,
.pause:not([data-mode="ended"]) .icon-replay {
  display: none;
}

/* On a phone the whole session fits on one screen: the brief keeps its title and task, and every
   pane is tighter. */
@media (max-width: 860px) {
  .panes {
    grid-template-columns: minmax(0, 1fr);
  }

  .pane + .pane {
    border-left: 0;
    border-top: 1px solid var(--line);
  }

  .head {
    height: 40px;
    padding-inline: var(--space-4);
  }

  .brief .head,
  .brief dl {
    display: none;
  }

  .body {
    gap: var(--space-2);
    padding: var(--space-4);
  }

  .brief h3 {
    font-size: var(--text-lg);
  }

  .editor {
    padding-block: var(--space-3);
    font-size: 11.5px;
    line-height: 1.7;
  }

  .ln {
    grid-template-columns: 32px minmax(0, 1fr);
  }

  .ln::before {
    padding-right: var(--space-3);
