---
// One editor theme in the theme panel: a few lines of code in its colours, and its name. The whole
// card is the label of a radio button, unseen, so a press anywhere on it chooses the theme.
import type { Palette } from '@sulba/editor/palettes';
import type { Token } from '@sulba/editor/specimen';

interface Props {
  palette: Palette;
  sample: Token[][];
  /** Said after the theme's name. */
  note?: string;
}

const { palette, sample, note } = Astro.props;

// The sample's tokens take their colours from these, as the editor does from the palette.
const colours = {
  '--ed-bg': palette.bg,
  '--ed-fg': palette.fg,
  '--ed-kw': palette.kw,
  '--ed-fn': palette.fn,
  '--ed-bi': palette.bi,
  '--ed-str': palette.str,
  '--ed-num': palette.num,
  '--ed-com': palette.com,
  '--ed-op': palette.op,
  '--ed-prop': palette.prop,
  '--ed-kw-weight': palette.boldKeywords ? '600' : 'normal',
  '--ed-com-style': palette.italicComments ? 'italic' : 'normal',
};
---

<label class="card">
  <input type="radio" name="editor-theme" value={palette.id} checked={palette.kind === 'page'}>
  <span class="sample" style={colours} aria-hidden="true" data-sample>
    {sample.map((line) => (
      <span class="line">
        {line.map(({ text, role }) => (role ? <span class={role}>{text}</span> : text))}
      </span>
    ))}
  </span>
  <span class="name">
    <span>
      {palette.name}{note && (
        <>
          {' '}
          <span class="note">{note}</span>
        </>
      )}
    </span>
    <span class="check" aria-hidden="true"></span>
  </span>
</label>

<style>
.card {
  position: relative;
  display: grid;
  gap: var(--space-2);
  min-width: 0;
  padding: 6px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  cursor: pointer;
  transition: border-color var(--duration-quick) var(--ease);
  -webkit-tap-highlight-color: transparent;
}

@media (hover: hover) {
  .card:hover {
    border-color: var(--line-strong);
  }
}

.card:has(:checked) {
  border-color: var(--fg);
}

/* The radio button covers its card, unseen, and the card shows its keyboard focus. */
.card input {
  position: absolute;
  inset: 0;
  margin: 0;
  opacity: 0;
  cursor: inherit;
}

.card:has(:focus-visible) {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.sample {
  display: block;
  overflow: hidden;
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-sm);
  background: var(--ed-bg);
  color: var(--ed-fg);
  font: var(--text-xs) / 1.6 var(--font-mono);
  white-space: pre;
}

.line {
  display: block;
}

.kw {
  color: var(--ed-kw);
  font-weight: var(--ed-kw-weight);
}

.fn {
  color: var(--ed-fn);
}

.bi {
  color: var(--ed-bi);
}

.str {
  color: var(--ed-str);
}

.num {
  color: var(--ed-num);
}

.com {
  color: var(--ed-com);
  font-style: var(--ed-com-style);
}

.op {
  color: var(--ed-op);
}

.prop {
  color: var(--ed-prop);
}

.name {
  display: flex;
  gap: var(--space-2);
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--space-1) 2px;
  font-size: var(--text-sm);
}

.note {
  color: var(--dim);
}

.check {
  flex: none;
  width: 14px;
  height: 14px;
  border: 1.5px solid var(--line-strong);
  border-radius: var(--radius-full);
}

.card:has(:checked) .check {
  border: 4px solid var(--fg);
}
</style>
