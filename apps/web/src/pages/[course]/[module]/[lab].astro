---
// A lab: its stages and the workspace learners write their code in. One page per lab, built from
// the course files.
import { getCollection } from 'astro:content';
import Page from '../../../layouts/Page.astro';
import { labFacts } from '../../../lib/lab-facts';
import type { LabEntry } from '../../../lib/labs';
import Workspace from '../../../workspace/Workspace';

export async function getStaticPaths() {
  const labs = await getCollection('labs');
  return labs.map(({ data }) => {
    const [course, module, lab] = data.path.split('/');
    return { params: { course, module, lab }, props: { entry: data } };
  });
}

// The review cards belong to the Review page, the data's text is served on its own
// (src/pages/data), and the credits are the page's, so the workspace is sent none of them.
const { entry } = Astro.props as { entry: LabEntry };
const { cards: _, files: __, order: ___, code, ...lab } = entry;
const facts = labFacts(lab);
const [course, module] = lab.path.split('/');
---

<Page title={`${lab.title} · Sulba`} editor>
  <header class="intro">
    <p class="label">
      <a href={`/${course}/#${module}`}>{lab.level} · {lab.module}</a>
    </p>
    <h1>{lab.title}</h1>
    <p class="lede">{lab.summary}</p>
  </header>

  <dl class="facts">
    {facts.map(({ term, value }) => (
      <div>
        <dt>{term}</dt>
        <dd>{value}</dd>
      </div>
    ))}
  </dl>

  <Workspace client:only="react" lab={lab}>
    <p slot="fallback" class="loading">Loading the workspace…</p>
  </Workspace>

  {(lab.data.length > 0 || code.length > 0) && (
    <footer class="credit">
      {lab.data.map((set) => (
        <p>
          Data: <a href={set.url}>{set.title}</a>, by {set.creators.join(', ')},{' '}
          <a href={set.licence.url}>{set.licence.name}</a>. {set.changes}
        </p>
      ))}
      {code.map((port) => (
        <div class="port">
          <p>
            Code: <a href={port.url}>{port.title}</a>, by {port.creators.join(', ')},{' '}
            <a href={port.licence.url}>{port.licence.name}</a>. {port.changes}
          </p>
          <details>
            <summary>Licence notice for {port.title}</summary>
            <p class="notice">{port.notice}</p>
          </details>
        </div>
      ))}
    </footer>
  )}
</Page>

<style>
.intro {
  display: grid;
  gap: var(--space-4);
  padding-block: var(--space-16) var(--space-8);
}

.label {
  color: var(--dim);
  font: 500 var(--text-xs) / 1.4 var(--font-mono);
  letter-spacing: var(--tracking-label);
  text-transform: uppercase;
}

h1 {
  font: 400 clamp(2.5rem, 5vw, 4rem) / 1 var(--font-display);
  letter-spacing: -0.01em;
}

.lede {
  max-width: 62ch;
  color: var(--dim);
  font-size: var(--text-lg);
  line-height: var(--leading);
}

.facts {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-4) var(--space-12);
  margin: 0 0 var(--space-10);
  padding-block: var(--space-5);
  border-block: 1px solid var(--line);
}

.facts dt {
  color: var(--dim);
  font: 500 var(--text-xs) / 1.4 var(--font-mono);
  letter-spacing: var(--tracking-label);
  text-transform: uppercase;
}

.facts dd {
  margin: var(--space-1) 0 0;
}

.loading {
  padding-block: var(--space-16);
  color: var(--dim);
  text-align: center;
}

.credit {
  margin-block: var(--space-8) var(--space-16);
  color: var(--dim);
  font-size: var(--text-sm);
  line-height: var(--leading);
}

.credit a {
  color: inherit;
}

.port {
  display: grid;
  gap: var(--space-2);
}

.credit summary {
  width: fit-content;
  cursor: pointer;
}

.notice {
  max-width: 62ch;
  margin-block-start: var(--space-2);
  white-space: pre-line;
}
</style>
