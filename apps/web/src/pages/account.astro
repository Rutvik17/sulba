---
import { buttonClass } from '@sulba/ui/button';
import SectionHeading from '../components/SectionHeading.astro';
import Page from '../layouts/Page.astro';
---

<Page title="Account · Sulba">
  <section class="sheet" data-account>
    <h1>Account</h1>
    <div data-when="in" hidden>
      <p class="lede">Signed in as <strong data-email></strong><span data-provider></span>.</p>
      <p class="about">
        Your account keeps the stages you've passed in each lab, and your reviews. Your code stays
        on the device you wrote it on.
      </p>
      <section class="study" aria-labelledby="days-studied" data-study hidden>
        <SectionHeading id="days-studied" text="Days studied" />
        <div data-study-loaded hidden>
          <p class="streak">
            <span class="count" data-streak-count></span>{' '}<span data-streak-words></span>
          </p>
          <div class="scroll">
            <div class="calendar" aria-hidden="true" data-calendar></div>
          </div>
          <p class="key" aria-hidden="true">
            <span><span class="swatch" data-studied="streak"></span>In your streak</span>
            <span><span class="swatch" data-studied></span>Other days studied</span>
          </p>
          <p class="summary" data-summary></p>
          <ul class="unseen" data-studied-list></ul>
        </div>
        <p data-study-failed hidden>
          Your days studied didn't load. Check your connection, then reload the page.
        </p>
      </section>
      <div class="actions" data-actions>
        <button class={buttonClass('outline')} type="button" data-sign-out>Sign out</button>
        <button class={buttonClass('ghost')} type="button" data-close>Close account</button>
      </div>
      <div class="confirm" data-confirm hidden>
        <p>
          Close your account? This deletes it and everything it recorded, and can't be undone. What
          this browser keeps on its own, such as your code, stays here.
        </p>
        <div class="actions">
          <button class={buttonClass('primary')} type="button" data-close-confirm>
            Close account
          </button>
          <button class={buttonClass('outline')} type="button" data-close-cancel>Keep it</button>
        </div>
      </div>
    </div>
    <div data-when="out" hidden>
      <p class="lede">You're not signed in.</p>
      <div class="actions">
        <a class={buttonClass('primary')} href="/sign-in/">Sign in</a>
      </div>
    </div>
    <p class="status" role="status" data-status></p>
  </section>
</Page>

<script>
import { PUBLIC_SUPABASE_PUBLISHABLE_KEY, PUBLIC_SUPABASE_URL } from 'astro:env/client';
import { closeAccount, currentLearner, providers, signOut } from '@sulba/data/account';
import { connect } from '@sulba/data/client';
import { localDay, Outbox } from '@sulba/data/outbox';
import { localStore } from '@sulba/data/session';
import { readStudyDays, type Streak, streakOf } from '@sulba/data/study';
import { send } from '@sulba/data/sync';
import { type Calendar, calendarOf } from '../lib/study';

const root = document.querySelector<HTMLElement>('[data-account]');
const find = <T extends HTMLElement>(selector: string) => root?.querySelector<T>(selector) ?? null;
const signedIn = find('[data-when="in"]');
const signedOut = find('[data-when="out"]');
const status = find('[data-status]');
const actions = find('[data-actions]');
const confirm = find('[data-confirm]');
const client = connect(PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_PUBLISHABLE_KEY);
const outbox = new Outbox(localStore());

function say(text: string) {
  if (status) status.textContent = text;
}

function showSignedOut() {
  delete document.documentElement.dataset.signedIn;
  if (signedIn) signedIn.hidden = true;
  if (signedOut) signedOut.hidden = false;
}

function busy(on: boolean) {
  for (const button of root?.querySelectorAll('button') ?? []) button.disabled = on;
}

async function show() {
  const learner = await currentLearner(client).catch(() => null);
  if (!learner) {
    showSignedOut();
    return;
  }
  const email = find('[data-email]');
  const provider = find('[data-provider]');
  if (email) email.textContent = learner.email ?? 'your account';
  if (provider && learner.provider) provider.textContent = ` with ${providers[learner.provider]}`;
  if (signedIn) signedIn.hidden = false;
  await showStudy();
}

/** The learner's streak and the calendar it comes from, after this browser's attempts are sent. */
async function showStudy() {
  const loaded = find('[data-study-loaded]');
  const failed = find('[data-study-failed]');
  try {
    await send(client, outbox).catch(() => false);
    const days = await readStudyDays(client);
    const today = localDay(new Date());
    const streak = streakOf(days, today);
    drawStudy(streak, calendarOf(days, streak, today), today);
    if (loaded) loaded.hidden = false;
  } catch {
    if (failed) failed.hidden = false;
  }
  const study = find('[data-study]');
  if (study) study.hidden = false;
}

function drawStudy(streak: Streak, calendar: Calendar, today: string) {
  const count = find('[data-streak-count]');
  const words = find('[data-streak-words]');
  const summary = find('[data-summary]');
  const list = find('[data-studied-list]');
  const until = streak.last === today ? 'today' : 'yesterday';
  if (count) count.textContent = String(streak.days);
  if (words) {
    words.textContent = `${streak.days === 1 ? 'day' : 'days'} in a row${
      streak.days > 0 ? `, up to ${until}` : ''
    }`;
  }
  if (summary) {
    summary.textContent = `You studied on ${calendar.studied.length} of the last ${calendar.span} days. A day counts when you work in a lab.`;
  }
  if (list) {
    list.setAttribute('aria-label', `Days studied in the last ${calendar.span} days`);
    list.replaceChildren(
      ...calendar.studied.map((day) => {
        const item = document.createElement('li');
        item.textContent = `${day.label}${day.inStreak ? ', in your streak' : ''}`;
        return item;
      }),
    );
  }
  const grid = find('[data-calendar]');
  if (grid) drawCalendar(grid, calendar);
}

/** Months over the weeks, weekdays down the side, and a square a day. */
function drawCalendar(grid: HTMLElement, calendar: Calendar) {
  const place = (element: HTMLElement, column: number, row: number) => {
    element.style.gridColumn = String(column);
    element.style.gridRow = String(row);
    return element;
  };
  const label = (text: string, kind: string) => {
    const element = document.createElement('span');
    element.className = kind;
    element.textContent = text;
    return element;
  };
  grid.style.setProperty('--weeks', String(calendar.weeks.length));
  grid.replaceChildren(
    ...calendar.months.map(({ week, name }) => place(label(name, 'month'), week + 2, 1)),
    ...['Mon', 'Wed', 'Fri'].map((name, n) => place(label(name, 'weekday'), 1, n * 2 + 2)),
    ...calendar.weeks.flatMap((days, week) =>
      days.flatMap((day, weekday) => {
        if (!day) return [];
        const square = place(document.createElement('span'), week + 2, weekday + 2);
        square.className = 'day';
        square.title = day.label;
        if (day.seconds > 0) square.dataset.studied = day.inStreak ? 'streak' : '';
        if (day.today) square.dataset.today = '';
        return [square];
      }),
    ),
  );
}

find('[data-sign-out]')?.addEventListener('click', async () => {
  busy(true);
  say('');
  try {
    // Attempts still waiting go to this account first, so none goes to the next one.
    await send(client, outbox).catch(() => false);
    outbox.clear();
    await signOut(client);
    showSignedOut();
    say('You signed out of this browser.');
  } catch {
    say("Couldn't sign out. Check your connection, then try again.");
  } finally {
    busy(false);
  }
});

find('[data-close]')?.addEventListener('click', () => {
  if (actions) actions.hidden = true;
  if (confirm) confirm.hidden = false;
  find('[data-close-cancel]')?.focus();
});

find('[data-close-cancel]')?.addEventListener('click', () => {
  if (confirm) confirm.hidden = true;
  if (actions) actions.hidden = false;
  find('[data-close]')?.focus();
});

find('[data-close-confirm]')?.addEventListener('click', async () => {
  busy(true);
  say('');
  try {
    outbox.clear();
    await closeAccount(client);
    showSignedOut();
    say('Your account is closed, and everything it recorded is deleted.');
  } catch {
    say("Couldn't close your account. Check your connection, then try again.");
  } finally {
    busy(false);
  }
});

void show();
</script>

<style>
.sheet {
  max-width: 34rem;
  padding-block: var(--space-16) var(--space-10);
}

h1 {
  font: 400 clamp(2.75rem, 6vw, 5rem) / 1 var(--font-display);
  letter-spacing: -0.02em;
}

.lede {
  margin-top: var(--space-6);
  font-size: var(--text-lg);
}

.about {
  margin-top: var(--space-3);
  color: var(--dim);
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  margin-top: var(--space-8);
}

.confirm {
  margin-top: var(--space-8);
  padding: var(--space-5);
  border: 1px solid var(--line-2);
  border-radius: var(--radius-lg);
}

.confirm .actions {
  margin-top: var(--space-5);
}

.status:not(:empty) {
  margin-top: var(--space-6);
}

.study {
  margin-top: var(--space-12);
}

.streak {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.count {
  font: 400 3.5rem / 1 var(--font-display);
  font-variant-numeric: tabular-nums;
}

.scroll {
  margin-top: var(--space-6);
  overflow-x: auto;
}

.calendar {
  --cell: 1rem;
  display: grid;
  grid-template-columns: auto repeat(var(--weeks), var(--cell));
  grid-template-rows: auto repeat(7, var(--cell));
  gap: 3px;
  width: max-content;
  font-size: var(--text-xs);
  color: var(--dim);
}

/* The script draws the calendar's contents, which scoped styles don't reach. */
.calendar :global(.month) {
  padding-bottom: var(--space-1);
  white-space: nowrap;
}

.calendar :global(.weekday) {
  align-self: center;
  padding-right: var(--space-2);
}

.calendar :global(.day),
.swatch {
  border-radius: 3px;
  background: var(--raise);
}

.swatch {
  display: inline-block;
  width: 0.75rem;
  height: 0.75rem;
  margin-right: var(--space-2);
  vertical-align: -0.0625rem;
}

.calendar :global(.day[data-studied]),
.swatch[data-studied] {
  background: var(--dim);
}

.calendar :global(.day[data-studied="streak"]),
.swatch[data-studied="streak"] {
  background: var(--accent);
}

.calendar :global(.day[data-today]) {
  outline: 1.5px solid var(--fg);
  outline-offset: 1px;
}

.key {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2) var(--space-5);
  margin-top: var(--space-4);
  font-size: var(--text-sm);
  color: var(--dim);
}

.summary {
  margin-top: var(--space-4);
  color: var(--dim);
}

.unseen {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}
</style>
