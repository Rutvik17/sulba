---
// Spaced review (decision record 20). The page carries every course's cards; its script shows the
// ones due from the stages this browser, or the learner's account, has passed.
import { getCollection } from 'astro:content';
import { buttonClass } from '@sulba/ui/button';
import Page from '../layouts/Page.astro';
import { ratings } from '../lib/review';

const cards = (await getCollection('labs')).flatMap(({ data: lab }) =>
  lab.cards.flatMap((card) => {
    const stage = lab.stages.find((each) => each.id === card.stage);
    if (!stage) return [];
    return [
      {
        ...card,
        source: `${lab.title} · ${stage.title}`,
        href: `/${lab.path}/?stage=${stage.slug}`,
      },
    ];
  }),
);
---

<Page title="Review · Sulba">
  <section class="sheet">
    <h1>Review</h1>
    <p class="lede">
      Cards from the stages you've passed. Each comes back when the chance you remember it has
      fallen to about 90%.
    </p>
    <p class="counts" data-counts hidden></p>
    <p class="note" data-loading>Loading your cards…</p>
    <p class="note" data-empty hidden>No cards yet. Each stage you pass adds its cards here.</p>
    <p class="note" tabindex="-1" data-done hidden></p>

    <article class="card" aria-labelledby="card-source" data-card hidden>
      <p class="source" id="card-source">
        <span data-source></span>{' '}<span class="new" data-new hidden>New</span>
      </p>
      <div class="side" tabindex="-1" data-front></div>
      <div class="actions" data-reveal>
        <button class={buttonClass('primary')} type="button" data-show>Show answer</button>
      </div>
      <div class="answer" data-answer hidden>
        <div class="side back" tabindex="-1" data-back></div>
        <fieldset class="ratings">
          <legend>How well did you remember it?</legend>
          <div class="buttons">
            {ratings.map(({ rating, name }) => (
              <button class={buttonClass('outline')} type="button" data-rating={rating}>
                <span>{name}</span> <span class="interval" data-interval={rating}></span>
              </button>
            ))}
          </div>
          <p class="hint">
            Again if you didn't remember it. Hard, Good or Easy if you did, by how much effort it
            took.
          </p>
        </fieldset>
      </div>
      <details class="history" data-history hidden>
        <summary>History</summary>
        <ol data-history-list></ol>
      </details>
    </article>

    {cards.map((card) => (
      <template data-card-id={card.id} data-stage={card.stage}>
        <span data-side="source">
          <a href={card.href}>{card.source}</a>
        </span>
        <div data-side="front" set:html={card.front} />
        <div data-side="back" set:html={card.back} />
      </template>
    ))}
  </section>
</Page>

<script>
import { PUBLIC_SUPABASE_PUBLISHABLE_KEY, PUBLIC_SUPABASE_URL } from 'astro:env/client';
import { isRating, type Rating, ReviewLog, reviewOf } from '@sulba/data/reviews';
import { hasSession, localStore } from '@sulba/data/session';
import {
  dueNow,
  intervals,
  nextDue,
  ratings,
  reviewLine,
  type Scheduled,
  schedule,
  whenDue,
} from '../lib/review';
import { keyboardScrollBoxes } from '../lib/scroll-boxes';
import { kept } from '../workspace/storage';

interface Card {
  readonly id: string;
  readonly stage: string;
  readonly template: HTMLTemplateElement;
}

function find<T extends HTMLElement = HTMLElement>(selector: string): T {
  const found = document.querySelector<T>(selector);
  if (!found) throw new Error(`The page has no ${selector}.`);
  return found;
}

const view = {
  counts: find('[data-counts]'),
  loading: find('[data-loading]'),
  empty: find('[data-empty]'),
  done: find('[data-done]'),
  card: find('[data-card]'),
  source: find('[data-source]'),
  new: find('[data-new]'),
  front: find('[data-front]'),
  reveal: find('[data-reveal]'),
  answer: find('[data-answer]'),
  back: find('[data-back]'),
  history: find('[data-history]'),
  historyList: find('[data-history-list]'),
};

const cards: Card[] = [
  ...document.querySelectorAll<HTMLTemplateElement>('template[data-card-id]'),
].map((template) => ({
  id: template.dataset.cardId ?? '',
  stage: template.dataset.stage ?? '',
  template,
}));

const storage = localStore();
const log = new ReviewLog(storage);
const passed = new Set(cards.map((card) => card.stage).filter((stage) => kept.passed(stage)));
let current: Scheduled<Card> | null = null;
let stopScrollBoxes = () => {};
// Signed in, the account may hold passes this browser doesn't, so an empty review waits for it.
let waiting = hasSession(storage);

/** A part of a card, copied from its template: the link to its stage, or a side. */
function sideOf(card: Card, side: 'source' | 'front' | 'back'): Node[] {
  const found = card.template.content.querySelector(`[data-side="${side}"]`);
  return found ? [...found.cloneNode(true).childNodes] : [];
}

/**
 * Shows the next card due, or what there is when none is. With `keep`, a card already showing
 * stays, so the account's reviews arriving don't take it from under the learner.
 */
function render({ keep = false, focus = false } = {}) {
  const now = new Date();
  const scheduled = schedule(
    cards.filter((card) => passed.has(card.stage)),
    log.all(),
  );
  const due = dueNow(scheduled, now);
  const reviewed = due.filter((each) => each.memory).length;
  view.counts.textContent = `${reviewed} to review · ${due.length - reviewed} new`;
  view.counts.hidden = due.length === 0;
  view.loading.hidden = !(waiting && scheduled.length === 0);
  if (keep && current && !view.card.hidden) return;

  current = due[0] ?? null;
  view.card.hidden = current === null;
  view.empty.hidden = !(scheduled.length === 0 && !waiting);
  view.done.hidden = !(current === null && scheduled.length > 0);
  if (!current) {
    const next = nextDue(scheduled);
    view.done.textContent = next
      ? `Nothing is due. The next card is due ${whenDue(next, now)}.`
      : 'Nothing is due.';
    if (focus && !view.done.hidden) view.done.focus();
    return;
  }

  const { card, memory, reviews } = current;
  view.source.replaceChildren(...sideOf(card, 'source'));
  view.new.hidden = memory !== null;
  view.front.replaceChildren(...sideOf(card, 'front'));
  view.back.replaceChildren(...sideOf(card, 'back'));
  stopScrollBoxes();
  stopScrollBoxes = keyboardScrollBoxes(view.card);
  view.reveal.hidden = false;
  view.answer.hidden = true;
  view.history.hidden = reviews.length === 0;
  view.historyList.replaceChildren(
    ...reviews.map((review) => {
      const item = document.createElement('li');
      item.textContent = reviewLine(review);
      return item;
    }),
  );
  if (focus) view.front.focus();
}

find('[data-show]').addEventListener('click', () => {
  if (!current) return;
  const labels = intervals(current.memory, new Date());
  for (const { rating } of ratings)
    find(`[data-interval="${rating}"]`).textContent = labels[rating];
  view.reveal.hidden = true;
  view.answer.hidden = false;
  view.back.focus();
});

for (const button of document.querySelectorAll<HTMLButtonElement>('[data-rating]')) {
  button.addEventListener('click', () => {
    const rating = Number(button.dataset.rating);
    if (!current || !isRating(rating)) return;
    answer(current.card, rating);
  });
}

function answer(card: Card, rating: Rating) {
  log.add(reviewOf(card.id, rating, new Date()));
  sync?.soon();
  render({ focus: true });
}

/** How long sending waits after a review, so a run of reviews goes in one request. */
const pause = 2000;

/**
 * While this browser holds a session, takes in the account's passes and reviews once a visit,
 * then sends the reviews it lacks after each review, and again when the connection returns.
 */
function startSync() {
  if (!hasSession(storage)) return null;
  const live = Promise.all([import('@sulba/data/client'), import('@sulba/data/sync')]).then(
    ([{ connect }, sync]) => ({
      ...sync,
      client: connect(PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_PUBLISHABLE_KEY),
    }),
  );
  // The ids the account has, or that it refused and aren't worth sending again.
  const known = new Set<string>();
  const ready = (async () => {
    const { client, readPassed, readReviews } = await live;
    const { data } = await client.auth.getSession();
    if (!data.session) return false;
    const [stages, reviews] = await Promise.all([readPassed(client), readReviews(client)]);
    for (const { stageId } of stages) passed.add(stageId);
    for (const review of reviews) known.add(review.id);
    log.takeIn(reviews);
    return true;
  })().catch(() => false);

  let timer: ReturnType<typeof setTimeout> | undefined;
  const flush = async () => {
    if (!(await ready) || !hasSession(storage)) return;
    const { client, sendReviews } = await live;
    const pending = log.all().filter((review) => !known.has(review.id));
    if (pending.length === 0) return;
    for (const id of await sendReviews(client, pending)) known.add(id);
  };
  const soon = () => {
    clearTimeout(timer);
    timer = setTimeout(() => void flush().catch(() => undefined), pause);
  };
  addEventListener('online', soon);
  void ready.then(() => {
    waiting = false;
    render({ keep: true });
    soon();
  });
  return { soon };
}

const sync = startSync();
render();
</script>

<style>
.sheet {
  max-width: 42rem;
  padding-block: var(--space-16) var(--space-10);
}

h1 {
  font: 400 clamp(2.75rem, 6vw, 5rem) / 1 var(--font-display);
  letter-spacing: -0.02em;
}

.lede {
  max-width: 56ch;
  margin-top: var(--space-6);
  color: var(--dim);
  font-size: var(--text-lg);
  line-height: var(--leading);
}

.counts {
  margin-top: var(--space-8);
  color: var(--dim);
  font: 500 var(--text-xs) / 1.4 var(--font-mono);
  font-variant-numeric: tabular-nums;
  letter-spacing: var(--tracking-label);
  text-transform: uppercase;
}

.note {
  margin-top: var(--space-8);
}

.card {
  display: grid;
  gap: var(--space-6);
  margin-top: var(--space-4);
  padding: var(--space-6);
  border: 1px solid var(--line-2);
  border-radius: var(--radius-lg);
}

.source {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: var(--space-3);
  font-size: var(--text-sm);
}

.source a {
  color: var(--dim);
}

.new {
  padding: 0 var(--space-2);
  border-radius: var(--radius-full);
  background: var(--raise);
  font: 500 var(--text-xs) / 1.6 var(--font-mono);
  letter-spacing: var(--tracking-label);
  text-transform: uppercase;
}

/*
  A card's sides are Markdoc's HTML, which scoped styles don't reach. One column as wide as the
  card keeps a wide table or formula from widening the text around it.
*/
.side {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-4);
  min-width: 0;
  font-size: var(--text-lg);
  line-height: var(--leading);
}

.side:focus {
  outline: none;
}

.side :global(article) {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-4);
}

.side :global(:is(p, ul, ol, math)) {
  margin: 0;
}

/* A table or a formula on its own lines scrolls sideways when it is wider than the text. */
.side :global([data-scroll]) {
  display: flex;
  overflow-x: auto;
  /* A formula's lines of text reach a little above and below it, which mustn't scroll. */
  overflow-y: hidden;
}

/* A formula is centred while it fits, and starts where the scrolling does when it doesn't. */
.side :global([data-scroll] > math) {
  margin-inline: auto;
}

.side :global(table) {
  flex: auto;
}

.side :global(code) {
  font-family: var(--font-mono);
  font-size: 0.92em;
}

.side :global(pre) {
  margin: 0;
  padding: var(--space-3);
  border-radius: var(--radius-sm);
  background: var(--surface);
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.answer {
  display: grid;
  gap: var(--space-6);
}

.back {
  padding-top: var(--space-6);
  border-top: 1px solid var(--line);
}

.ratings {
  margin: 0;
  padding: 0;
  border: 0;
}

.ratings legend {
  margin-bottom: var(--space-3);
  padding: 0;
  font-weight: 500;
}

.buttons {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--space-2);
}

.buttons button {
  flex-direction: column;
  height: auto;
  padding-block: var(--space-2);
  gap: 0;
}

.interval {
  color: var(--dim);
  font-size: var(--text-xs);
  font-variant-numeric: tabular-nums;
}

.hint {
  margin-top: var(--space-3);
  color: var(--dim);
  font-size: var(--text-sm);
}

.history summary {
  color: var(--dim);
  font-size: var(--text-sm);
  cursor: pointer;
}

.history ol {
  display: grid;
  gap: var(--space-1);
  margin-top: var(--space-3);
  padding-left: var(--space-5);
  color: var(--dim);
  font-size: var(--text-sm);
  font-variant-numeric: tabular-nums;
}

@media (max-width: 30rem) {
  .buttons {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
</style>
