---
import { getCollection } from 'astro:content';
import LabScroll from '../../components/LabScroll.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SessionClip from '../../components/SessionClip.astro';
import Page from '../../layouts/Page.astro';
import { academyPage } from '../../lib/academy';
import { courseOutlines } from '../../lib/course';

const levels = ['Beginner', 'Intermediate', 'Advanced', 'Master', 'Elite'];
// The first course, whose name links its page once it has labs to list.
const [course] = courseOutlines((await getCollection('labs')).map(({ data }) => data));
const href = course && academyPage(course.slug);
const title = course?.title ?? 'AI Engineering';
---

<Page title="Sulba · The school of the AI era">
  <section class="hero">
    <h1>The school of the AI era</h1>
    <div class="intro">
      <p class="lede">
        Learn the fundamentals by hand, then catch what an AI assistant gets wrong and ship code
        that works in production.
      </p>
      <dl class="meta">
        <div>
          <dt>First course</dt>
          <dd>{href ? <a href={href}>{title}</a> : title}</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd class="status">In development</dd>
        </div>
      </dl>
    </div>
    <SessionClip />
  </section>

  <section class="statement" aria-label="What Sulba is for">
    <p><strong>AI writes code in seconds.</strong> You still have to know if it's right.</p>
  </section>

  <section aria-labelledby="steps">
    <SectionHeading id="steps" text="How every lab runs" />
    <LabScroll />
  </section>

  <section aria-labelledby="courses">
    <SectionHeading id="courses" text="Courses" />
    <article class="course">
      <div>
        <h3>{href ? <a href={href}>{title}</a> : title}</h3>
        <p class="pill">In development</p>
      </div>
      <div>
        <p>From Python for programmers to ML compilers, in five levels.</p>
        <ol class="levels">
          {levels.map((level, i) => (
            <li>
              <span>{String(i + 1).padStart(2, '0')}</span>
              {level}
            </li>
          ))}
        </ol>
      </div>
    </article>
  </section>

  <section aria-labelledby="companies">
    <SectionHeading id="companies" text="For companies" />
    <p class="companies">
      We want to build courses with engineering teams, based on their own systems and standards.
    </p>
    <p class="write"><a href="/contact/">Write to us</a></p>
  </section>
</Page>

<style>
.hero {
  padding-block: var(--space-16) var(--space-12);
}

h1 {
  font: 400 clamp(3rem, 7.6vw, 6.5rem) / 0.95 var(--font-display);
  letter-spacing: -0.02em;
}

/* Past a laptop's width the title keeps growing with the screen, from where it was, until it
   nearly fills the sheet. */
@media (min-width: 1441px) {
  h1 {
    font-size: clamp(6.5rem, 7.22vw, 9.5rem);
  }
}

.intro {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: var(--space-8) var(--space-16);
  align-items: end;
  margin-top: var(--space-8);
}

.lede {
  max-width: 54ch;
  font-size: var(--text-lg);
  color: var(--dim);
}

.meta {
  display: flex;
  gap: var(--space-10);
}

dt,
.pill,
.levels span {
  font: 500 var(--text-xs) / 1.2 var(--font-mono);
  letter-spacing: var(--tracking-label);
  text-transform: uppercase;
}

dt {
  color: var(--dim);
}

dd {
  margin-top: var(--space-2);
  font-weight: 500;
}

.status {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
}

.status::before {
  content: "";
  width: 7px;
  height: 7px;
  border: 1px solid var(--fg);
  border-radius: 50%;
}

section + section {
  margin-top: var(--space-24);
}

.statement p {
  max-width: 30ch;
  font: 400 clamp(1.75rem, 3.6vw, 3rem) / 1.12 var(--font-display);
  letter-spacing: -0.01em;
  color: var(--dim);
}

.statement strong {
  font-weight: 400;
  color: var(--fg);
}

.levels {
  margin: 0;
  padding: 0;
  list-style: none;
}

.course p,
.companies {
  color: var(--dim);
}

.course {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
  gap: var(--space-6) var(--space-12);
  padding-bottom: var(--space-6);
  border-bottom: 1px solid var(--line);
}

.course h3 {
  font: 400 2.25rem / 1.1 var(--font-display);
}

.pill {
  display: inline-flex;
  align-items: center;
  height: 24px;
  margin-top: var(--space-3);
  padding-inline: var(--space-3);
  border: 1px dashed var(--line-strong);
  border-radius: var(--radius-full);
}

.levels {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-4);
}

.levels li {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  height: 30px;
  padding-inline: var(--space-3);
  border: 1px solid var(--line-2);
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
}

.levels span {
  color: var(--dim);
}

.companies {
  max-width: 60ch;
  font-size: var(--text-lg);
}

.write {
  margin-top: var(--space-5);
  font-weight: 500;
}

@media (max-width: 820px) {
  .intro,
  .course {
    grid-template-columns: minmax(0, 1fr);
  }
}
</style>
