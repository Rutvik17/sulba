---
import Frame from '../components/Frame.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SessionClip from '../components/SessionClip.astro';
import TeachArt from '../components/TeachArt.astro';
import Page from '../layouts/Page.astro';

// Each module runs in this order.
const steps = [
  {
    kind: 'sketch',
    name: 'Sketch',
    text: "Sketch how you'd solve the module's real problem before it's taught, and get feedback on your approach.",
  },
  {
    kind: 'build',
    name: 'Build it yourself',
    text: 'Write the core of each system by hand, so you know how it works underneath.',
  },
  {
    kind: 'design',
    name: 'Design',
    text: 'Choose the architecture, write down why, and set the tests the code must pass.',
  },
  {
    kind: 'with-ai',
    name: 'Build with AI',
    text: 'Direct an assistant from your design, and accept its code only once it passes your tests and your review.',
  },
  {
    kind: 'review',
    name: 'Review',
    text: "Find and fix what's wrong in an assistant's code: bugs, security holes, slow or messy parts.",
  },
] as const;

const levels = ['Beginner', 'Intermediate', 'Advanced', 'Master', 'Elite'];
---

<Page title="Sulba · The school of the AI era">
  <section class="hero">
    <h1>The school of the AI era</h1>
    <div class="intro">
      <p class="lede">
        Learn the fundamentals by hand, then build with AI: design the system, direct the assistant,
        and review every line it writes.
      </p>
      <dl class="meta">
        <div>
          <dt>First course</dt>
          <dd>AI Engineering</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd class="status">In development</dd>
        </div>
      </dl>
    </div>
    <SessionClip />
  </section>

  <section class="statement" aria-label="What Sulba is for">
    <p>
      <strong>AI writes code in seconds.</strong>{' '}
      It still needs someone who knows the right architecture, the efficient solution and the secure
      design. Sulba teaches that, one task at a time.
    </p>
  </section>

  <section aria-labelledby="steps">
    <SectionHeading id="steps" text="How each module runs" />
    <ol class="steps">
      {steps.map(({ kind, name, text }, i) => (
        <li>
          <Frame>
            <div class="plate">
              <TeachArt kind={kind} />
            </div>
          </Frame>
          <h3>
            <span class="number">{String(i + 1).padStart(2, '0')}</span>
            {name}
          </h3>
          <p>{text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="courses">
    <SectionHeading id="courses" text="Courses" />
    <article class="course">
      <div>
        <h3>AI Engineering</h3>
        <p class="pill">In development</p>
      </div>
      <div>
        <p>From Python for programmers to ML compilers, in five levels.</p>
        <ol class="levels">
          {levels.map((level, i) => (
            <li>
              <span>{String(i + 1).padStart(2, '0')}</span>
              {level}
            </li>
          ))}
        </ol>
      </div>
    </article>
  </section>

  <section aria-labelledby="companies">
    <SectionHeading id="companies" text="For companies" />
    <p class="companies">
      We want to build courses with engineering teams, modelled on how they work: their systems,
      their tools and their standards.
    </p>
    <p class="write"><a href="/contact/">Write to us</a></p>
  </section>
</Page>

<style>
.hero {
  padding-block: var(--space-16) var(--space-12);
}

h1 {
  font: 400 clamp(3rem, 7.6vw, 6.5rem) / 0.95 var(--font-display);
  letter-spacing: -0.02em;
}

.intro {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: var(--space-8) var(--space-16);
  align-items: end;
  margin-top: var(--space-8);
}

.lede {
  max-width: 54ch;
  font-size: var(--text-lg);
  color: var(--dim);
}

.meta {
  display: flex;
  gap: var(--space-10);
}

dt,
.number,
.pill,
.levels span {
  font: 500 var(--text-xs) / 1.2 var(--font-mono);
  letter-spacing: var(--tracking-label);
  text-transform: uppercase;
}

dt {
  color: var(--dim);
}

dd {
  margin-top: var(--space-2);
  font-weight: 500;
}

.status {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
}

.status::before {
  content: "";
  width: 7px;
  height: 7px;
  border: 1px solid var(--fg);
  border-radius: 50%;
}

section + section {
  margin-top: var(--space-24);
}

.statement p {
  max-width: 30ch;
  font: 400 clamp(1.75rem, 3.6vw, 3rem) / 1.12 var(--font-display);
  letter-spacing: -0.01em;
  color: var(--dim);
}

.statement strong {
  font-weight: 400;
  color: var(--fg);
}

.steps,
.levels {
  margin: 0;
  padding: 0;
  list-style: none;
}

.steps {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: var(--space-6);
}

.steps li {
  display: grid;
  gap: var(--space-3);
  align-content: start;
}

.plate {
  aspect-ratio: 3 / 2;
}

.steps h3 {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
  margin-top: var(--space-3);
  font-size: var(--text-lg);
  font-weight: 600;
}

.number {
  color: var(--dim);
}

.steps p,
.course p,
.companies {
  color: var(--dim);
}

.course {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
  gap: var(--space-6) var(--space-12);
  padding-bottom: var(--space-6);
  border-bottom: 1px solid var(--line);
}

.course h3 {
  font: 400 2.25rem / 1.1 var(--font-display);
}

.pill {
  display: inline-flex;
  align-items: center;
  height: 24px;
  margin-top: var(--space-3);
  padding-inline: var(--space-3);
  border: 1px dashed var(--line-strong);
  border-radius: var(--radius-full);
}

.levels {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-4);
}

.levels li {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  height: 30px;
  padding-inline: var(--space-3);
  border: 1px solid var(--line-2);
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
}

.levels span {
  color: var(--dim);
}

.companies {
  max-width: 60ch;
  font-size: var(--text-lg);
}

.write {
  margin-top: var(--space-5);
  font-weight: 500;
}

@media (max-width: 1180px) {
  .steps {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-10) var(--space-6);
  }
}

@media (max-width: 820px) {
  .intro,
  .course {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (max-width: 720px) {
  .steps {
    grid-template-columns: minmax(0, 1fr);
  }

  .plate {
    aspect-ratio: 2 / 1;
  }
}
</style>
