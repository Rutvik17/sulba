# Keeps the site out of search results until launch (Phase 5). Preview addresses keep it after that.
/*
  X-Robots-Tag: noindex

# Each Pyodide release has its own folder, so its files never change and can be cached for good.
/pyodide/*
  Cache-Control: public, max-age=31536000, immutable

# A lab's dataset is served from a folder named for its text, so its file never changes either.
/data/*
  Cache-Control: public, max-age=31536000, immutable

# So is each file of a lab's project.
/project/*
  Cache-Control: public, max-age=31536000, immutable
