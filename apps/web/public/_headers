# Keeps the site out of search results until launch (Phase 5). Preview addresses keep it after that.
# No other site may show a page in a frame, where a page laid over it could trick a person into
# pressing a button, such as Allow on the consent page an agent sends them to.
/*
  X-Robots-Tag: noindex
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

# Each Pyodide release has its own folder, so its files never change and can be cached for good.
/pyodide/*
  Cache-Control: public, max-age=31536000, immutable

# A lab's dataset is served from a folder named for its text, so its file never changes either.
/data/*
  Cache-Control: public, max-age=31536000, immutable

# So is each of a lab's recorded references.
/references/*
  Cache-Control: public, max-age=31536000, immutable

# And each file of a lab's project.
/project/*
  Cache-Control: public, max-age=31536000, immutable
