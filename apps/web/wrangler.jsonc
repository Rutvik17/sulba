{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-06",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker answers the app's addresses with its page, and its files are served as they are
    // (record 54). Every other route the Worker renders is named here too, as an address left out
    // gets the static assets' 404 page (record 55); src/worker-first.test.ts checks the list.
    "run_worker_first": [
      "/app/*",
      "!/app/assets/*",
      "/api/*",
      "/mcp",
      "/.well-known/oauth-protected-resource/*"
    ]
  },
  "routes": [{ "pattern": "sulba.dev", "custom_domain": true }],
  "workers_dev": false,
  // Worker Previews need this on; Cloudflare Access keeps every preview address private (record 9).
  "preview_urls": true,
  // Branch Previews use no bindings of their own.
  "previews": {},
  "observability": {
    "enabled": true
  }
}
