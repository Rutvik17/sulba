{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-06",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "sulba.dev", "custom_domain": true }],
  "workers_dev": false,
  // Worker Previews need this on; Cloudflare Access keeps every preview address private (record 9).
  "preview_urls": true,
  // Branch Previews use no bindings of their own.
  "previews": {},
  "observability": {
    "enabled": true
  }
}
