{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":semanticCommitsDisabled", "group:allNonMajor"],
  "timezone": "America/Toronto",
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "description": "@astrojs/check supports TypeScript 5 and 6 only",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "The lab's Python packages move with Pyodide, which ships them for the browser",
      "matchFileNames": ["packages/lab/python/**"],
      "matchPackageNames": ["!ruff"],
      "enabled": false
    },
    {
      "description": "A lab project's packages move with Pyodide too, so learners run what the browser runs",
      "matchFileNames": ["courses/**/project/**", "packages/content/fixtures/**/project/**"],
      "enabled": false
    },
    {
      "description": "Major @types/node updates move with the Node version in .node-version",
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
